
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AI_PROVIDER=auto

# Free-tier safety controls
GEMINI_MAX_REQUESTS_PER_RUN=10
GEMINI_REQUEST_DELAY_SECONDS=5
GEMINI_MAX_WINDOWS_PER_EPISODE=5

# Promo duration
PROMO_MIN_DURATION=20
PROMO_MAX_DURATION=60

APP_ENV=development
LOG_LEVEL=INFO

DATA_DIR=data
INPUT_DIR=data/input
PROCESSED_DIR=data/processed
CACHE_DIR=data/cache
EXPORT_DIR=data/exports


